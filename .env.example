# Copy to .env and adjust. Values below are for LOCAL DEVELOPMENT ONLY.
# Never commit a real .env.

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me-locally

# Used when running Django outside Docker (Compose overrides it).
# Compose publishes Postgres on host port 5433 to avoid clashing with a local install.
DATABASE_URL=postgres://helpdesk:change-me-locally@localhost:5433/helpdesk

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
# 0-1 probability the simulated e-mail send fails, to watch Celery retries (e.g. 0.3).
# Only applies when EMAIL_PROVIDER=console.
NOTIFICATION_SIMULATED_FAILURE_RATE=0

# --- E-mail (notification delivery) ---
# "console" (default): logs identifiers only, never sends — safe for local dev/CI.
# "ses": sends real e-mail via Amazon SES (needs a verified sender identity, and on
# AWS the task's IAM role needs ses:SendEmail; leave keys unset there).
EMAIL_PROVIDER=console
AWS_SES_REGION_NAME=ap-south-1
EMAIL_FROM_ADDRESS=helpdesk@example.com

# --- Object storage (attachments) ---
# Locally: SeaweedFS (S3-compatible) from docker-compose. On AWS: leave the endpoint and
# keys unset in the task environment so boto3 uses regional S3 and the task IAM role.
AWS_STORAGE_BUCKET_NAME=helpdesk-attachments
AWS_S3_REGION_NAME=ap-south-1
S3_ACCESS_KEY=helpdesk-local
S3_SECRET_KEY=change-me-locally-s3
# Max upload size in bytes (default 25 MB).
ATTACHMENT_MAX_BYTES=26214400

# --- Demo ---
# Shows one-click demo accounts on the login page. Never enable in production.
DEMO_MODE=True

# --- Seed demo data on backend start (1/0) ---
SEED_DATA=1
